<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>Daily Journal</title>
</head>

<body>
    <!-- Activity 4: Insert code here to include the header (found in the partials folder) to your page -->
    <%- include('partials/navbar') %>
        <div class="container mt-4">
            <h2>Welcome to Daily Journal</h2>
            <table class="table table-striped">
                <tbody>
                    <% for (let i=0; i < journalEntries.length; i++) { %>
                        <tr>
                            <td>
                                <h5>
                                    <%= journalEntries[i].title %>
                                </h5>
                                <p><strong>Date:</strong> <br>
                                    <%= journalEntries[i].date %>
                                </p>
                                <p><strong>Journal:</strong><br>
                                    <%= journalEntries[i].content %>
                                </p>
                                <div class="d-flex gap-2">
                                    <a href="/edit/<%= i %>" class="btn btn-primary btn-sm" style="display:inline;">Edit</a>
                                    <form action="/delete/<%= i %>" method="POST" style="display:inline;">
                                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        <% } %>
                </tbody>
            </table>
        </div>
</body>

</html>